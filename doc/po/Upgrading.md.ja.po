"| -volnamelen | volnamelen | 80 | 80 | (G) | - |\n"
"| -setuplog | log level | default log_note | default:note | (G) | - |\n"
"| -setuplog | log file | - | - | (G) | - |\n"
"| -admingroup | admingroup | - | - | (G) | - |\n"
"| -k5service | k5 service | - | - | (G) | - |\n"
"| -k5realm | k5 realm | - | - | (G) | - |\n"
