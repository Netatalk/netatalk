"| TIMELORD_RUN | - | no | - | - | 独自起動スクリプトで制御 |\n"
"| A2BOOT_RUN | - | no | - | - | 独自起動スクリプトで制御 |\n"
"| ATALK_BGROUND | - | no | - | - | 廃止 |\n"
"| ATALK_ZONE | ddp zone | - | - | (G) | 4.0.0で復活 |\n"

