# Supported daemons share a domain: netatalk -> afpd.
# Also match /usr/bin for distributions where /usr/sbin is a symlink.
/usr/s?bin/netatalk               --      gen_context(system_u:object_r:netatalk_exec_t,s0)
/usr/s?bin/afpd                   --      gen_context(system_u:object_r:netatalk_exec_t,s0)

# Keep excluded executables labeled even when a full build installs them.
/usr/s?bin/cnid_metad             --      gen_context(system_u:object_r:netatalk_legacy_exec_t,s0)
/usr/s?bin/cnid_dbd               --      gen_context(system_u:object_r:netatalk_legacy_exec_t,s0)

# The specific session-bus label overrides the configuration directory rule.
/etc/netatalk(/.*)?                      gen_context(system_u:object_r:netatalk_etc_t,s0)
/etc/netatalk/dbus-session\.conf --      gen_context(system_u:object_r:netatalk_dbus_conf_t,s0)

# State and SQLite databases (including WAL, SHM, and journal files).
/var/lib/netatalk                -d      gen_context(system_u:object_r:netatalk_var_lib_t,s0)
/var/lib/netatalk/CNID(/.*)?              gen_context(system_u:object_r:netatalk_cnid_t,s0)
/var/lib/netatalk/afp_signature\.conf --  gen_context(system_u:object_r:netatalk_var_lib_t,s0)
/var/lib/netatalk/afp_voluuid\.conf   --  gen_context(system_u:object_r:netatalk_var_lib_t,s0)

# /var/lock is a symlink to /run/lock on many distributions.
/var/lock/netatalk(/.*)?                  gen_context(system_u:object_r:netatalk_lock_t,s0)
/run/lock/netatalk(/.*)?                  gen_context(system_u:object_r:netatalk_lock_t,s0)

# Shared volume paths are site-specific; label them with semanage fcontext.

# Log files
/var/log/netatalk\.log           --      gen_context(system_u:object_r:netatalk_log_t,s0)
/var/log/netatalk(/.*)?                  gen_context(system_u:object_r:netatalk_log_t,s0)
