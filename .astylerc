# astyle base ruleset: One True Brace Style
--style=1tbs

# See the astyle docs for descriptions of individual rules:
# https://astyle.sourceforge.net/astyle.html
--add-braces
--align-pointer=name
--align-reference=name
--break-blocks
--delete-empty-lines
--exclude=build
--exclude=builddir
--exclude=libatalk/unicode/precompose.h
--exclude=libatalk/unicode/utf16_case.c
--exclude=libatalk/unicode/utf16_casetable.h
# workaround for astyle bug:
# https://gitlab.com/saalen/astyle/-/work_items/111
--exclude=etc/spotlight/xapian/sl_xapian.h
--ignore-exclude-errors-x
--indent=spaces=4
--max-code-length=80
--max-code-length-mode=ignore-side-comments
--max-continuation-indent=60
--pad-comma
--pad-header
--pad-oper
--unpad-paren
